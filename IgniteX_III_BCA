#1. Grid method implementation :
#Create a 10x10 grid (2D array) and implement a Python program that draws a specific shape (e.g., triangle, square, or circle) based 
#on dynamic inputs like shape type, size, and position. HINT: The grid should be initialized with 0s. The shape should be represented using the digit 1.

def Square(grid,x,y,s):
    for i in range(x,x+s):
        for j in range(y,y+s):
            grid[i][j] = 1
    for i in grid:
        print(i)

def Triangle(grid,x,y,s):
    val = 1
    for i in range(x,x+s):
        for j in range(val):
            grid[i][y+j] = 1
        val += 1    
    for i in grid:
        print(i)       
        
def Circle(grid,x,y,s):
    for i in range(x-(s-1),x+(s)):
        for j in range(y,y+s):
            if i ==x-(s-1) and (j == (y+s)-1 or j == y):
                continue
            elif i == (x+s)-1 and (j == (y+s)-1 or j == y):
                continue
            else:
                grid[i][j] = 1
    for i in grid:
        print(i)               



